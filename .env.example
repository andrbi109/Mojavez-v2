# نمونهٔ فایل متغیرهای محیطی برای پروژهٔ Mojavez v2
# ----------------------------------------------------------------
# این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید.
# فایل .env هرگز نباید در کنترل نسخه قرار گیرد (.gitignore).

# ==================== حالت اشکال‌زدایی ====================
# در محیط توسعه true و روی سرور واقعی حتماً false باشد.
# نکته: auto-debug حذف شده — باید صریح تنظیم شود.
# روی XAMPP/لوکال: APP_DEBUG=true
# روی سرور تولید: APP_DEBUG=false
APP_DEBUG=true

# ==================== پایگاه داده ====================
DB_HOST=localhost
DB_NAME=handicraft_license
DB_USER=root
DB_PASS=

# ==================== پایهٔ URL ====================
# در لوکال معمولاً '/' و روی سرور واقعی مسیر زیردامنه یا '/' است.
BASE_URL=/

# ==================== استفاده از CDN ====================
# برای Bootstrap؛ روی سرور واقعی توصیه می‌شود false (آسیت‌های محلی).
USE_CDN=false

# ==================== رمز امنیتی برای endpoint های عمومی ====================
# برای محافظت از /check-cancel و سایر endpoint هایی که فقط باید از cron فراخوانی شوند.
# یک رشتهٔ ۶۴ کاراکتری تصادفی تولید کنید: openssl rand -hex 32
CRON_SECRET=

# ==================== تنظیمات نشست ====================
SESSION_LIFETIME=86400

# ==================== محل ذخیرهٔ لاگ خطاها (اختیاری) ====================
# اگر خالی باشد، PHP از پیش‌فرض سرور استفاده می‌کند.
# توصیه: مسیری خارج از DocumentRoot، قابل نوشتن توسط کاربر PHP-FPM/Apache.
# مثال لینوکس: /var/log/php/mojavez-error.log
ERROR_LOG_PATH=

# ==================== محدودیت نرخ درخواست عمومی ====================
# حداکثر تعداد درخواست در دقیقه برای endpoint هایی که بدون login هستند.
PUBLIC_RATE_LIMIT_PER_MIN=30

# ==================== احراز هویت اختیاری برای tracking عمومی ====================
# اگر true باشد، کد رهگیری به‌تنهایی کافی نیست؛ کاربر باید موبایل را هم وارد کند.
TRACKING_REQUIRE_MOBILE=false

# ==================== محدودیت آی‌پی (اختیاری — allowlist) ====================
# لیست آی‌پی‌های مجاز برای دسترسی به پنل مدیریت، با کاما جدا شوند.
# اگر خالی باشد، همهٔ آی‌پی‌ها مجازند (پیش‌فرض).
# مثال: 192.168.1.10,192.168.1.20
ADMIN_IP_ALLOWLIST=

# ==================== محدودیت آی‌پی (اختیاری — denylist) ====================
# لیست آی‌پی‌های مسدودشده، با کاما جدا شوند.
# اگر خالی باشد، هیچ آی‌پی مسدود نمی‌شود.
IP_BLOCKLIST=

# ==================== نشانهٔ محیط ====================
# اگر production باشد، برخی هشدارهای امنیتی در لاگ ثبت می‌شوند (مثل فعالیت از IP مسدودشده).
# اگر development باشد، لاگ‌های بیشتری تولید می‌شود.
APP_ENV=development

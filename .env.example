# نمونهٔ فایل متغیرهای محیطی برای پروژهٔ Mojavez v2
# ----------------------------------------------------------------
# این فایل را کپی کنید به .env و مقادیر واقعی را جایگزین کنید.
# فایل .env هرگز نباید در کنترل نسخه قرار گیرد (.gitignore).

# ==================== حالت اشکال‌زدایی ====================
# در محیط توسعه true و روی سرور واقعی حتماً false باشد.
APP_DEBUG=true

# ==================== پایگاه داده ====================
DB_HOST=localhost
DB_NAME=handicraft_license
DB_USER=root
DB_PASS=

# ==================== پایهٔ URL ====================
# در لوکال معمولاً '/' و روی سرور واقعی مسیر زیردامنه یا '/' است.
BASE_URL=/

# ==================== استفاده از CDN ====================
# برای Bootstrap؛ روی سرور واقعی توصیه می‌شود false (آسیت‌های محلی).
USE_CDN=false

# ==================== رمز امنیتی برای endpoint های عمومی ====================
# برای محافظت از /check-cancel و سایر endpoint هایی که فقط باید از cron فراخوانی شوند.
# یک رشتهٔ ۶۴ کاراکتری تصادفی تولید کنید: openssl rand -hex 32
CRON_SECRET=

# ==================== تنظیمات نشست ====================
SESSION_LIFETIME=86400

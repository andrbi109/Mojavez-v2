# ============================================================
# .dockerignore — فایل‌ها/پوشه‌هایی که نباید در تصویر داکر کپی شوند
# ------------------------------------------------------------
# این فایل در ریشهٔ پروژه قرار دارد و هنگام build با context=ریشه
# توسط داکر اعمال می‌شود. نسخهٔ کپی در deploy/docker/.dockerignore
# نیز نگه‌داری می‌شود.
# ============================================================

# ---------- فایل‌های بارگذاری‌شدهٔ کاربران ----------
# محتوای uploads نباید وارد تصویر شود (حریم خصوصی + حجم).
# اما .htaccess حفظ می‌شود چون لایهٔ دفاعی امنیتی است.
uploads/*
!uploads/.htaccess

# ---------- لاگ‌ها ----------
*.log
logs/
**/*.log

# ---------- کنترل نسخه و متاداده ----------
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# ---------- وابستگی‌ها و کش‌ها ----------
node_modules/
vendor/
composer.lock

# ---------- کش‌ها و فایل‌های موقت سیستم‌عامل ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
desktop.ini

# ---------- فایل‌های پشتیبان ----------
*.bak
*.sql.gz
*.tar
*.tar.gz
*.zip
backup/
backups/

# ---------- محیط توسعه و ابزارها ----------
dev-server.sh
tests/tmp/
tests/*.output
tests/*.actual
.cache/
.vscode/
.idea/
*.iml

# ---------- فایل‌های محیطی حساس ----------
# هرگز فایل .env واقعی نباید وارد تصویر شود (فقط .env.example مجاز است)
.env
.env.local
.env.*.local
deploy/docker/.env

# ---------- خروجی‌های ابزار و گزارش‌ها ----------
tests/static-analysis-report.json
pg.html
*.md.bak

# ---------- فایل‌های خود داکر (جلوگیری از ورود به تصویر) ----------
# نکته: Dockerfile را مستثنی نمی‌کنیم تا سازگاری با تمام نسخه‌های داکر
#       (به‌ویژه BuildKit) حفظ شود. docker-compose نیز به‌دلیل ارجاع به
#       متغیرها و نبود راز، مشکلی در تصویر ایجاد نمی‌کند؛ ولی برای
#       تمیزی، فایل‌های compose را مستثنی می‌کنیم.
docker-compose*.yml
docker-compose*.yaml

# ---------- Docker layer cache ----------
.docker/

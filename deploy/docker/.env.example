# ============================================================
# .env.example — نمونهٔ تنظیمات محیطی سامانهٔ Mojavez
# ------------------------------------------------------------
# راهنما:
#   ۱) این فایل را به `.env` کپی کنید:  cp .env.example .env
#   ۲) مقادیر را متناسب با محیط خود تغییر دهید.
#   ۳) هرگز فایل `.env` واقعی را در گیت commit نکنید.
# ============================================================

# ----------------------------------------------------------
# تنظیمات پایگاه داده
# ----------------------------------------------------------
# هاست دیتابیس — نام سرویس db در docker-compose است.
DB_HOST=db

# نام دیتابیس (باید با نام در schema.sql مطابقت داشته باشد)
DB_NAME=handicraft_license

# کاربری که سامانه با آن به دیتابیس متصل می‌شود (در MariaDB ساخته می‌شود)
DB_USER=mojavez

# رمز عبور کاربر سامانه — حتماً در محیط تولید تغییر دهید!
DB_PASS=secret

# رمز root دیتابیس — حتماً در محیط تولید یک رمز قوی انتخاب کنید!
DB_ROOT_PASS=rootsecret

# پورت دیتابیس (داخلی کانتینر؛ معمولاً نیازی به تغییر نیست)
DB_PORT=3306

# ----------------------------------------------------------
# تنظیمات اپلیکیشن
# ----------------------------------------------------------
# حالت اشکال‌زدایی — در محیط تولید حتماً false باشد.
APP_DEBUG=false

# اجرای خودکار schema.sql در اولین راه‌اندازی (۱=بله، ۰=خیر)
# نکته: این متغیر توسط entrypoint بررسی می‌شود و در صورت ۱ بودن،
#       schema.sql روی دیتابیس اجرا می‌شود. بعد از ساخت اولین جدول،
#       می‌توانید آن را ۰ کنید.
INIT_DB=1

# ----------------------------------------------------------
# تنظیمات شبکه و پورت
# ----------------------------------------------------------
# پورتی که سامانه روی آن در دسترس قرار می‌گیرد (پورت میزبان برای nginx)
MOJAVEZ_PORT=8080

# ----------------------------------------------------------
# تنظیمات محلی (اختیاری)
# ----------------------------------------------------------
# منطقهٔ زمانی پیش‌فرض
TZ=Asia/Tehran

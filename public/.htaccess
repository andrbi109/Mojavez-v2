# =================================================================
# Mojavez — قواعد مسیریابی و امنیت در DocumentRoot (public/)
# -----------------------------------------------------------------
# این سامانه خصوصی است:
#   • موتورهای جستجو و خزنده‌ها (Google/Bing/AI bots) مسدود می‌شوند.
#   • دسترسی مستقیم به فایل‌های حساس ممنوع است.
#   • هدرهای امنیتی و کش‌گذاری بهینه اعمال می‌شود.
# =================================================================

# --- فعال‌سازی موتور بازنویسی ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # اگر فایل یا پوشهٔ واقعی نیست، به index.php هدایت کن
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# --- امنیت: جلوگیری از لیست شدن پوشه‌ها و اجرای CGI ---
Options -Indexes -ExecCGI +FollowSymLinks

# --- کاراکترست پیش‌فرض ---
AddDefaultCharset UTF-8

# --- امنیت: مخفی‌کردن امضای Apache و نسخهٔ سرور ---
ServerTokens Prod
ServerSignature Off

# --- امنیت: مسدودسازی موتورهای جستجو و خزنده‌های هوش مصنوعی ---
# این سامانه خصوصی است و نباید ایندکس شود.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # شناسایی بات‌های شناخته‌شده (با User-Agent)
    RewriteCond %{HTTP_USER_AGENT} (Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|ia_archiver|Applebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|CCBot|anthropic-ai|Claude-Web|cohere-ai|Google-Extended|PerplexityBot|Amazonbot|Bytespider|Diffbot|FacebookBot|Meta-ExternalAgent|OAI-SearchBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (SemrushBot|AhrefsBot|MJ12bot|DotBot|BLEXBot|SeznamBot|PetalBot|DotBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (MaJestic12|MJ12bot|BUbiNG|SiteAuditBot|SEO diverted|spider|crawler|scraping|wget|curl|python-requests|libwww-perl) [NC]
    RewriteRule ^ - [R=410,L]
</IfModule>

# --- امنیت: مسدودسازی دسترسی مستقیم به فایل‌های مخفی و حساس ---
<FilesMatch "(^\.|\.(env|sql|md|sh|py|bak|log|lock|json|yaml|yml|ini|conf|swp|tmp|orig|dist)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- امنیت: جلوگیری از اجرای PHP در پوشه‌های آپلود (در صورت سرو شدن) ---
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# --- امنیت: هدرهای امنیتی جامع ---
<IfModule mod_headers.c>
    # X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
    # این سامانه خصوصی است و نباید ایندکس شود.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

    # جلوگیری از sniffing نوع محتوا
    Header always set X-Content-Type-Options "nosniff"

    # مقابله با Clickjacking — فقط این سایت می‌تواند صفحه را embed کند
    Header always set X-Frame-Options "SAMEORIGIN"

    # سیاست Referrer — فقط origin در صورت خروج از سایت
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # غیرفعال‌سازی APIهای حساس مرورگر
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"

    # Content-Security-Policy — اجازه فقط به منابع هم‌خانواده (same-origin)
    # Bootstrap از CDN استفاده می‌شود اگر USE_CDN=true، در غیر این صورت محلی است.
    # این سیاست به‌صورت پیش‌فرض محافظه‌کارانه تنظیم شده است؛ در صورت نیاز به inline script، nonce اضافه کنید.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"

    # Cross-Origin Opener Policy و Embedder Policy — محافظت در برابر حملات Spectre-class
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "unsafe-none"
    Header always set Cross-Origin-Resource-Policy "same-site"

    # HSTS فقط روی HTTPS فعال شود (max-age=1 سال، شامل زیردامنه‌ها، آماده برای preload)
    <IfModule mod_ssl.c>
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </IfModule>

    # Cache-Control برای صفحات HTML — no-store برای صفحات پویا
    # برای صفحات خطا (4xx/5xx) همواره no-store
    Header always set Cache-Control "no-store, no-cache, must-revalidate" env=ERROR_RESPONSE
</IfModule>

# --- فشرده‌سازی پاسخ‌ها ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/xml+rss
    # سطح فشرده‌سازی (۹ = بیشترین)
    DeflateCompressionLevel 6
    # فایل‌های کوچک‌تر از ۱۵۰ بایت فشرده نشوند (سربار بیش از سود)
    DeflateInflateLimitRequestBody 150
</IfModule>

# --- کش مرورگر برای فایل‌های استاتیک ---
<IfModule mod_expires.c>
    ExpiresActive On
    # فایل‌های استاتیک با نسخه (مثل app.js?v=2.0.1) کش طولانی می‌شوند
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

# --- ETag برای کش‌گذاری شرطی (پایداری و سرعت) ---
FileETag MTime Size

# --- مسدودسازی برخی روش‌های HTTP خطرناک (فقط GET/POST/HEAD/OPTIONS مجاز) ---
<LimitExcept GET POST HEAD OPTIONS>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</LimitExcept>

# --- امنیت: جلوگیری از اجرای فایل‌های PHP در فایل‌های آپلود (لایهٔ دوم) ---
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar)$">
    <IfModule mod_php.c>
        # اگر این فایل مستقیماً درخواست شود و index.php نباشد، اجرا نشود
        SetHandler none
    </IfModule>
</FilesMatch>

# --- خطای سفارشی برای کد 410 (بات‌های مسدودشده) ---
ErrorDocument 410 "<!DOCTYPE html><html lang='fa' dir='rtl'><head><meta charset='UTF-8'><title>دسترسی مسدود</title><style>body{font-family:Tahoma,sans-serif;text-align:center;padding:3rem;background:#f8f9fa}h1{color:#6c757d}</style></head><body><h1>۴۱۰ — دسترسی برای خزنده‌ها مسدود است</h1><p>این سامانه خصوصی است.</p></body></html>"

# --- صفحات خطای سفارشی ---
ErrorDocument 403 "<!DOCTYPE html><html lang='fa' dir='rtl'><head><meta charset='UTF-8'><title>دسترسی ممنوع</title></head><body><h1>۴۰۳ — دسترسی ممنوع</h1></body></html>"
ErrorDocument 404 "<!DOCTYPE html><html lang='fa' dir='rtl'><head><meta charset='UTF-8'><title>یافت نشد</title></head><body><h1>۴۰۴ — صفحه یافت نشد</h1></body></html>"
